#!/usr/bin/env bash
# Check the claims in research findings files, cheapest first, before anyone reopens a web page.
#
#   quorum-research-check FILE...
#
# Each FILE is a researcher's findings (.tasks/<slug>/research/<n>-<lens>.md), whose claims look like:
#
#   1. [VERIFIED] load() reads the file as UTF-8.
#      Source: app/report.py:9 @ 1a2b3c4
#      Quote: with open(path, encoding="utf-8") as f:
#   2. [CITED] csv.writer quotes a field that holds the delimiter.
#      Source: https://docs.python.org/3.12/library/csv.html (fetched 2026-11-11; Python 3.12)
#      Quote: only quote those fields which contain special characters
#      Decision: yes
#   3. [ASSUMED] Finance opens the file in Excel.
#
# VERIFIED is a repo claim (Source: path:line or path:first-last, then optionally @ sha and a note), CITED a web
# one, ASSUMED one with no source. A repo quote may be wrapped in backticks or quotes, and may be several pieces
# joined by " / ": each piece must be on the cited lines.
# Prints one line per claim, FILE#N<TAB>RESULT<TAB>WHY:
#
#   OK       a repo claim whose quote is on its line, or a cited one with a quote, no numbers, and no decision on it
#   MOVED    a repo claim whose quote is in the file, but on another line (WHY names it): a warning
#   DROP     a repo claim whose quote isn't in the file, or that has no quote to check
#   VERIFY   a cited claim to reopen (source-verifier): it has numbers, or a decision rests on it, or no quote
#   ASK      an ASSUMED claim, for the user to confirm or correct; it doesn't go into the spec as fact
#   ERROR    a claim missing its source, or a cited claim missing its fetch date
#
# Repo paths are relative to the working tree the code is in (quorum-active-task --code). Exits 1 if any claim is
# ERROR, else 0. Bash 3.2 compatible.
set -uo pipefail

die() { echo "quorum-research-check: $*" >&2; exit 2; }
HERE=$(cd "$(dirname "$0")" && pwd)
[ $# -gt 0 ] || die "usage: quorum-research-check FILE..."
CODE=$("$HERE/quorum-active-task" --code 2>/dev/null) || CODE=$(pwd)

errors=0
for file in "$@"; do
  [ -f "$file" ] || die "no such file: $file"
  # One record per claim: N<TAB>TAG<TAB>CLAIM<TAB>SOURCE<TAB>QUOTE<TAB>DECISION
  records=$(awk '
    function flush() { if (n != "") print n "\t" tag "\t" claim "\t" src "\t" quote "\t" dec; n = "" }
    /^[0-9]+\.[ \t]+\[(VERIFIED|CITED|ASSUMED)\]/ {
      flush()
      n = $0; sub(/\..*/, "", n)
      tag = $0; sub(/^[^[]*\[/, "", tag); sub(/\].*/, "", tag)
      claim = $0; sub(/^[^]]*\][ \t]*/, "", claim)
      src = ""; quote = ""; dec = ""; next
    }
    n != "" && /^[ \t]+Source:/ { src = $0; sub(/^[ \t]+Source:[ \t]*/, "", src); next }
    n != "" && /^[ \t]+Quote:/ { quote = $0; sub(/^[ \t]+Quote:[ \t]*/, "", quote); sub(/^"/, "", quote); sub(/"[ \t]*$/, "", quote); next }
    n != "" && /^[ \t]+Decision:/ { dec = tolower($0); sub(/^[ \t]+decision:[ \t]*/, "", dec); next }
    n != "" && /^[^ \t]/ { flush() }
    END { flush() }
  ' "$file")
  while IFS="$(printf '\t')" read -r n tag claim src quote dec; do
    [ -n "$n" ] || continue
    id="$file#$n"
    result=""; why=""
    case "$tag" in
      VERIFIED)
        # The first path:line or path:first-last in the Source, whatever follows it.
        loc=$(printf '%s' "$src" | grep -Eo '^[^ ]+:[0-9]+(-[0-9]+)?' | head -n 1)
        path=${loc%:*}; span=${loc##*:}; first=${span%-*}; last=${span#*-}
        if [ -z "$loc" ]; then
          result=ERROR; why="a repo claim needs Source: path:line"
        elif [ -z "$quote" ]; then
          result=DROP; why="no Quote: to check against $loc"
        elif [ ! -f "$CODE/$path" ]; then
          result=DROP; why="$path doesn't exist"
        else
          result=OK; why=$loc
          # Each piece of the quote, without its backticks or quote marks.
          # shellcheck disable=SC2016  # the backtick is a literal Markdown code mark
          pieces=$(printf '%s\n' "$quote" | awk '{ n = split($0, p, " / "); for (i = 1; i <= n; i++) print p[i] }' \
            | sed -E 's/^[[:space:]]*[`"]?//; s/[`"]?[[:space:]]*$//')
          while IFS= read -r piece; do
            [ -n "$piece" ] || continue
            if sed -n "${first},${last}p" "$CODE/$path" | grep -qF -- "$piece"; then continue; fi
            at=$(grep -nF -- "$piece" "$CODE/$path" | head -n 1 | cut -d: -f1)
            if [ -n "$at" ]; then
              [ "$result" = DROP ] || { result=MOVED; why="the quote is at $path:$at, not :$span"; }
            else
              result=DROP; why="the quote isn't in $path"
            fi
          done <<PIECES
$pieces
PIECES
        fi ;;
      CITED)
        url=$(printf '%s' "$src" | grep -Eo 'https?://[^ )]+' | head -n 1)
        if [ -z "$url" ]; then result=ERROR; why="a cited claim needs Source: a URL"
        elif ! printf '%s' "$src" | grep -Eq 'fetched [0-9]{4}-[0-9]{2}-[0-9]{2}'; then result=ERROR; why="$url has no (fetched YYYY-MM-DD)"
        elif [ -z "$quote" ]; then result=VERIFY; why="no quote from $url"
        elif printf '%s' "$claim" | grep -q '[0-9]'; then result=VERIFY; why="it has numbers: $url"
        elif [ "$dec" = yes ]; then result=VERIFY; why="a decision rests on it: $url"
        else result=OK; why="$url"; fi ;;
      ASSUMED) result=ASK; why=$claim ;;
    esac
    [ "$result" = ERROR ] && errors=$((errors + 1))
    printf '%s\t%s\t%s\n' "$id" "$result" "$why"
  done <<EOF
$records
EOF
done
[ "$errors" -eq 0 ]
