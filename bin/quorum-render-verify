#!/usr/bin/env bash
# Print a repo's .claude/hooks/verify-completion.sh: the fast checks (typecheck, lint, unit tests) that the Stop
# hook runs before Claude or the builder may finish.
#
#   quorum-render-verify [--typecheck CMD] [--lint CMD] [--test CMD] [--check NAME=CMD]...
#
# At least one check is required. The generated script runs every check from the repo root (even after one
# fails, so the output shows every failure), exits 0 only if all pass, and needs only bash.
set -euo pipefail

die() { echo "quorum-render-verify: $*" >&2; exit 1; }

names=(); cmds=()
add() {
  printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9_-]*$' || die "invalid check name: $1"
  [ -n "$2" ] || die "empty command for $1"
  case "$2" in *$'\n'*) die "command for $1 has a newline" ;; esac
  names+=("$1"); cmds+=("$2")
}

while [ $# -gt 0 ]; do
  case "$1" in
    --typecheck|--lint|--test) [ $# -ge 2 ] || die "$1 needs a command"; add "${1#--}" "$2"; shift 2 ;;
    --check) [ $# -ge 2 ] || die "--check needs NAME=CMD"; add "${2%%=*}" "${2#*=}"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ ${#names[@]} -gt 0 ] || die "give at least one check (--typecheck, --lint, --test, or --check NAME=CMD)"

sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

cat <<'EOF'
#!/usr/bin/env bash
# Fast verification checks for this repo, generated by /quorum:init-pipeline.
# The Quorum Stop hook runs this before Claude or the builder may finish a task. It must exit 0 only when every
# check passes. Keep it fast (typecheck, lint, unit tests); slow suites belong in a task's eval.md.
# Keep it in sync with the "## Verification Commands" section of CLAUDE.md.
set -uo pipefail
cd "$(dirname "$0")/../.." || exit 1

failed=""
check() {
  echo "== $1: $2"
  if ! bash -c "$2"; then failed="$failed $1"; fi
}

EOF
i=0
while [ $i -lt ${#names[@]} ]; do
  printf 'check %s %s\n' "${names[$i]}" "$(sq "${cmds[$i]}")"
  i=$((i + 1))
done
cat <<'EOF'

if [ -n "$failed" ]; then
  echo "FAILED:$failed" >&2
  exit 1
fi
echo "All checks passed."
EOF
