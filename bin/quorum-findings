#!/usr/bin/env bash
# Parse review findings in Quorum's format (REVIEW.md section 2, plan section 3.4) from a file or stdin.
#
# A finding starts at the beginning of a line with a tag, then its file:line, then for [IMPORTANT] a Pattern
# Category; the lines after it (until the next finding, a heading, or a blank line followed by a non-indented
# line) are its body:
#
#   [IMPORTANT] app/report.py:42 — Pattern Category: Unescaped CSV fields
#   Confidence: 90
#   Mechanism: a customer name with a comma splits into two columns.
#
# `Confidence:` (0-100, how sure the reviewer is the finding is real) is optional; a finding without one counts
# as the least confident.
#
#   quorum-findings summary [FILE]          "Summary: 1 IMPORTANT, 2 NIT, 0 PRE-EXISTING"
#   quorum-findings count TAG [FILE]        number of findings with TAG (IMPORTANT, NIT, PRE-EXISTING)
#   quorum-findings important [FILE]        the [IMPORTANT] findings with their bodies, for the builder
#   quorum-findings categories [FILE]       distinct Pattern Categories of [IMPORTANT] findings, one per line
#   quorum-findings cap N [FILE]            all findings, keeping only the N most confident [NIT]s (first wins ties)
#   quorum-findings check [FILE]            exit 1 and list problems: an [IMPORTANT] without file:line or category,
#                                           or a Confidence that isn't a whole number from 0 to 100
#   quorum-findings scope RANGE [FILE]      the findings the voter should see (stdout), and those it needn't (stderr,
#                                           one "DROP <finding head> — out of scope: <why>" line each): an
#                                           [IMPORTANT] or [NIT] whose file the range doesn't change, whose line is
#                                           more than 3 lines from a changed one, or whose line has a lint-ignore
#                                           comment (noqa, eslint-disable, nolint, @ts-ignore, #[allow(, ...).
#                                           [PRE-EXISTING] findings, and findings citing .tasks/ or no file:line,
#                                           always stay. Run it from the working tree the range is in.
#
# Lines starting with anything else (for example "DROP" lines from the verifier-voter) are not findings.
set -euo pipefail

die() { echo "quorum-findings: $*" >&2; exit 1; }
HERE=$(cd "$(dirname "$0")" && pwd)
# Through quorum-git, so a sandbox that hides the real git behind Apple's launcher doesn't break this script.
git() { "$HERE/quorum-git" "$@"; }
cmd=${1:-}; shift || true

# Normalize into records: TAG<TAB>header line<TAB>body (body lines joined with \037)
records() {
  awk '
    function flush() { if (tag != "") { print tag "\t" head "\t" body }; tag = ""; head = ""; body = "" }
    /^\[(IMPORTANT|NIT|PRE-EXISTING)\]/ {
      flush()
      tag = $0; sub(/^\[/, "", tag); sub(/\].*$/, "", tag)
      head = $0; next
    }
    /^#/ || /^(DROP|KEEP|Summary:)/ { flush(); next }
    tag != "" {
      if ($0 ~ /^[ \t]*$/) { blank = 1; next }
      if (blank && $0 !~ /^[ \t]/ && $0 !~ /^(Confidence|Mechanism|Why|Fix|Evidence|Pattern Category):/) { flush(); blank = 0; next }
      blank = 0
      body = (body == "" ? $0 : body "\037" $0)
    }
    END { flush() }
  ' "${1:--}"
}

src() { if [ -n "${1:-}" ]; then [ -f "$1" ] || die "no such file: $1"; printf '%s' "$1"; fi; }

case "$cmd" in
  summary)
    r=$(records "$(src "${1:-}")")
    i=$(printf '%s\n' "$r" | grep -c '^IMPORTANT	' || true)
    n=$(printf '%s\n' "$r" | grep -c '^NIT	' || true)
    p=$(printf '%s\n' "$r" | grep -c '^PRE-EXISTING	' || true)
    if [ "$i$n$p" = "000" ]; then echo "Summary: 0 issues found. Ready to land."
    else echo "Summary: $i IMPORTANT, $n NIT, $p PRE-EXISTING"; fi ;;

  count)
    tag=${1:-}; shift || true
    case "$tag" in IMPORTANT|NIT|PRE-EXISTING) ;; *) die "count needs IMPORTANT, NIT, or PRE-EXISTING" ;; esac
    records "$(src "${1:-}")" | grep -c "^$tag	" || true ;;

  important)
    records "$(src "${1:-}")" | awk -F '\t' '$1 == "IMPORTANT" { if (n++) print ""; print $2; m = split($3, b, "\037"); for (i = 1; i <= m; i++) if (b[i] != "") print b[i] }' ;;

  categories)
    records "$(src "${1:-}")" | awk -F '\t' '$1 == "IMPORTANT" && match($2, /Pattern Category:[ ]*/) { c = substr($2, RSTART + RLENGTH); sub(/[ \t]+$/, "", c); if (!(c in seen)) { seen[c] = 1; print c } }' ;;

  cap)
    n=${1:-}; shift || true
    printf '%s' "$n" | grep -Eq '^[0-9]+$' || die "cap needs a number"
    # Keep the N most confident nits (no Confidence line counts as -1; earlier wins ties), in their original order.
    records "$(src "${1:-}")" | awk -F '\t' -v cap="$n" '
      function conf(body,   m, b, i, v) {
        m = split(body, b, "\037")
        for (i = 1; i <= m; i++) if (b[i] ~ /^Confidence:[ ]*[0-9]+/) { v = b[i]; sub(/^Confidence:[ ]*/, "", v); return v + 0 }
        return -1
      }
      { tag[NR] = $1; head[NR] = $2; body[NR] = $3; if ($1 == "NIT") c[NR] = conf($3) }
      END {
        for (r = 1; r <= NR; r++) {
          if (tag[r] != "NIT") continue
          better = 0
          for (o = 1; o <= NR; o++) if (tag[o] == "NIT" && (c[o] > c[r] || (c[o] == c[r] && o < r))) better++
          if (better >= cap) drop[r] = 1
        }
        for (r = 1; r <= NR; r++) {
          if (drop[r]) continue
          if (k++) print ""; print head[r]; m = split(body[r], b, "\037"); for (i = 1; i <= m; i++) if (b[i] != "") print b[i]
        }
      }' ;;

  check)
    bad=$(records "$(src "${1:-}")" | awk -F '\t' '
      { h = $2 }
      h !~ /^\[[A-Z-]+\] [^ ]+:[0-9]+/ { print "missing file:line: " h; next }
      $1 == "IMPORTANT" && h !~ /Pattern Category:[ ]*[^ ]/ { print "missing Pattern Category: " h }
      {
        m = split($3, b, "\037")
        for (i = 1; i <= m; i++) if (b[i] ~ /^Confidence:/) {
          v = b[i]; sub(/^Confidence:[ ]*/, "", v); sub(/[ \t]+$/, "", v)
          if (v !~ /^[0-9]+$/ || v + 0 > 100) print "Confidence must be 0-100: " h
        }
      }')
    if [ -n "$bad" ]; then printf '%s\n' "$bad" >&2; exit 1; fi ;;

  scope)
    range=${1:-}; shift || true
    [ -n "$range" ] || die "scope needs a git range"
    diff=$(git diff -U0 --no-color --no-ext-diff "$range") || die "can't diff $range"
    # The changed lines, as PATH<TAB>FIRST<TAB>LAST per hunk of the new side; then the findings.
    awk -F '\t' -v win=3 '
      function lines_of(path,   l, n) {
        if (path in loaded) return
        loaded[path] = 1; n = 0
        while ((getline l < path) > 0) text[path, ++n] = l
        close(path)
      }
      function emit(r,   m, b, i) {
        if (k++) print ""; print head[r]; m = split(body[r], b, "\037"); for (i = 1; i <= m; i++) if (b[i] != "") print b[i]
      }
      FNR == NR { nh++; hp[nh] = $1; hs[nh] = $2; he[nh] = $3; changed[$1] = 1; next }
      {
        r = FNR; tag[r] = $1; head[r] = $2; body[r] = $3; why = ""
        if ($1 != "PRE-EXISTING" && match($2, /^\[[A-Z-]+\] [^ :]+:[0-9]+/)) {
          loc = substr($2, index($2, "] ") + 2); path = loc; sub(/:.*/, "", path)
          n = loc; sub(/^[^:]*:/, "", n); sub(/[^0-9].*$/, "", n); n += 0
          if (path !~ /^\.tasks\//) {
            if (!(path in changed)) why = "the range doesn'"'"'t change " path
            else {
              near = 0
              for (h = 1; h <= nh; h++) if (hp[h] == path && n >= hs[h] - win && n <= he[h] + win) { near = 1; break }
              if (!near) why = "line " n " is more than " win " lines from a changed line"
              else {
                lines_of(path)
                if (text[path, n] ~ /(noqa|eslint-disable|nolint|@ts-ignore|@ts-expect-error|#\[allow\(|NOSONAR|pylint: *disable|rubocop: *disable|type: *ignore|nosec)/)
                  why = "line " n " has a lint-ignore comment"
              }
            }
          }
        }
        if (why == "") emit(r)
        else print "DROP " $2 " — out of scope: " why > "/dev/stderr"
      }
    ' <(printf '%s\n' "$diff" | awk '
          /^\+\+\+ / { f = substr($0, 5); sub(/^b\//, "", f); next }
          /^@@ / { split($0, a, " "); split(substr(a[3], 2), b, ","); c = b[2] == "" ? 1 : b[2] + 0
                   first = b[1] + 0; last = c == 0 ? first : first + c - 1; print f "\t" first "\t" last }') \
      <(records "$(src "${1:-}")") ;;

  *) die "usage: quorum-findings summary|count TAG|important|categories|cap N|check [FILE]|scope RANGE [FILE]" ;;
esac
