#!/usr/bin/env bash
# Git helpers for Quorum tasks.
#
#   quorum-branch default                 print the default branch (origin/HEAD, else main, else master)
#   quorum-branch start SLUG [--fix] [--worktree]
#                                         switch to feat/SLUG (fix/SLUG with --fix), creating it from the default
#                                         branch; record base_sha in the task's state.md; print the branch.
#                                         With --worktree, check it out in its own git worktree instead, at
#                                         .claude/worktrees/SLUG under the root, and leave this working tree as it
#                                         is: print the branch, then the worktree's path, and record it as the
#                                         task's `worktree`. Exit 3 if REVIEW.md, CLAUDE.md, or
#                                         .claude/hooks/verify-completion.sh isn't committed on the branch the
#                                         worktree starts from (a worktree only gets committed files)
#   quorum-branch remove SLUG             remove the task's worktree (git worktree remove) and clear `worktree`; the
#                                         branch stays. Exit 3 if it has uncommitted changes
#   quorum-branch merged                  tasks whose worktree is still there though their work merged: SLUG<TAB>PATH.
#                                         Merged means GitHub says the task's `pr` merged (gh), or else that its
#                                         branch has commits and all of them are on the default branch
#   quorum-branch is-merged SLUG          exit 0 if the task's work merged, by the same test, with or without a
#                                         worktree (the map's task graph waits on it)
#   quorum-branch range                   the diff range to review now: base_sha..HEAD before any builder round,
#                                         then round_shas[-1]..HEAD (convergence Rule 2: new lines only)
#   quorum-branch record                  push HEAD onto round_shas (call just before each builder run)
#
# The task's folder moves into the worktree's own .tasks/, and the main tree's .tasks/<slug> becomes a link to it: a
# session Claude Code moves into the worktree may write only inside it. The worktree's .tasks/ and .claude/worktrees/
# go in the repository's info/exclude, so git never shows or commits them. remove moves the folder back first. Refuses to switch branches with uncommitted changes.
# Bash 3.2 compatible.
set -euo pipefail

die() { echo "quorum-branch: $*" >&2; exit 1; }
HERE=$(cd "$(dirname "$0")" && pwd)
# Through quorum-git, so a sandbox that hides the real git behind Apple's launcher doesn't break this script.
git() { "$HERE/quorum-git" "$@"; }
ROOT=$("$HERE/quorum-active-task" --root)
MAIN=$("$HERE/quorum-active-task" --main)
cd "$("$HERE/quorum-active-task" --code)"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo: $ROOT"

default_branch() {
  local ref
  if ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then printf '%s\n' "${ref#origin/}"; return; fi
  for b in main master; do
    if git show-ref --verify --quiet "refs/heads/$b"; then printf '%s\n' "$b"; return; fi
  done
  git branch --show-current
}

# is_merged SLUG: GitHub says the task's `pr` merged (gh), or else its branch (the worktree's, or feat/ or fix/SLUG)
# has commits and all of them are on the default branch. A squash merge shows only through gh.
is_merged() {
  local slug=$1 pr path branch base
  pr=$("$HERE/quorum-state" --task "$slug" get pr 2>/dev/null) || return 1
  if [ -n "$pr" ] && command -v gh >/dev/null 2>&1; then
    [ "$(gh pr view "$pr" --json state -q .state 2>/dev/null)" = MERGED ]; return
  fi
  path=$("$HERE/quorum-state" --task "$slug" get worktree)
  if [ -n "$path" ] && [ -d "$path" ]; then branch=$(git -C "$path" branch --show-current 2>/dev/null)
  elif [ "$("$HERE/quorum-state" --task "$slug" get bug)" = true ]; then branch=fix/$slug
  else branch=feat/$slug
  fi
  base=$("$HERE/quorum-state" --task "$slug" get base_sha)
  [ -n "$branch" ] && [ -n "$base" ] && git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null \
    && [ "$(git rev-parse "$branch")" != "$base" ] && git merge-base --is-ancestor "$branch" "$(default_branch)" 2>/dev/null
}

case "${1:-}" in
  default)
    default_branch ;;

  start)
    slug=${2:-}; [ -n "$slug" ] || die "start needs a slug"
    prefix=feat; wt=0
    for arg in "${@:3}"; do
      case "$arg" in --fix) prefix=fix ;; --worktree) wt=1 ;; *) die "unknown option: $arg" ;; esac
    done
    [ -f "$ROOT/.tasks/$slug/state.md" ] || die "no state file for task $slug (run /quorum:spec-and-eval first)"
    state() { "$HERE/quorum-state" --task "$slug" "$@"; }
    def=$(default_branch)
    if [ "$wt" = 1 ]; then
      branch="$prefix/$slug"
      for b in "feat/$slug" "fix/$slug"; do git show-ref --verify --quiet "refs/heads/$b" && { branch=$b; break; }; done
      from=$def; git show-ref --verify --quiet "refs/heads/$branch" && from=$branch
      missing=""
      for f in REVIEW.md CLAUDE.md .claude/hooks/verify-completion.sh; do
        git cat-file -e "$from:$f" 2>/dev/null || missing="$missing $f"
      done
      if [ -n "$missing" ]; then
        echo "quorum-branch: can't make a worktree: not committed on $from:$missing. A worktree only gets committed files; commit them, or build in this working tree." >&2
        exit 3
      fi
      path="$MAIN/.claude/worktrees/$slug"
      common=$(git rev-parse --path-format=absolute --git-common-dir)
      if [ -d "$path" ] && [ "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" = "$common" ]; then
        :
      elif git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add -q "$path" "$branch" || die "couldn't check out $branch in a worktree (is it checked out elsewhere?)"
      else
        git worktree add -q -b "$branch" "$path" "$def"
      fi
      mkdir -p "$common/info"
      for pat in /.claude/worktrees/ /.tasks; do
        grep -qxF -- "$pat" "$common/info/exclude" 2>/dev/null || printf '%s\n' "$pat" >> "$common/info/exclude"
      done
      # The path as git and `quorum-active-task --code` print it, with symlinks resolved (macOS /var is /private/var).
      path=$(cd "$path" && pwd -P)
      if [ ! -L "$MAIN/.tasks/$slug" ]; then
        [ ! -e "$path/.tasks/$slug" ] || die "$path/.tasks/$slug already exists"
        mkdir -p "$path/.tasks"
        mv "$MAIN/.tasks/$slug" "$path/.tasks/$slug"
        ln -s "$path/.tasks/$slug" "$MAIN/.tasks/$slug"
      fi
      if [ -z "$(state get base_sha)" ]; then
        state set base_sha "$(git -C "$path" merge-base HEAD "$def" 2>/dev/null || git -C "$path" rev-parse HEAD)"
      fi
      state set worktree "$path"
      printf '%s\n%s\n' "$branch" "$path"
      exit 0
    fi
    cur=$(git branch --show-current)
    case "$cur" in
      "feat/$slug"|"fix/$slug") branch=$cur ;;
      *)
        if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
          die "uncommitted changes on $cur; commit or stash them before starting $prefix/$slug"
        fi
        branch="$prefix/$slug"
        if git show-ref --verify --quiet "refs/heads/$branch"; then
          git switch -q "$branch"
        else
          git switch -q -c "$branch" "$def"
        fi ;;
    esac
    base=$(state get base_sha)
    if [ -z "$base" ]; then
      if [ "$branch" = "$def" ]; then die "refusing to work on the default branch $def"; fi
      base=$(git merge-base HEAD "$def" 2>/dev/null || git rev-parse HEAD)
      state set base_sha "$base"
    fi
    printf '%s\n' "$branch" ;;

  remove)
    slug=${2:-}; [ -n "$slug" ] || die "remove needs a slug"
    path=$("$HERE/quorum-state" --task "$slug" get worktree)
    [ -n "$path" ] || die "task $slug has no worktree"
    if [ -d "$path" ]; then
      [ "$(cd "$path" && pwd -P)" != "$(pwd -P)" ] || die "you're in $slug's worktree; remove it from the main working tree"
      if [ -n "$(git -C "$path" status --porcelain)" ]; then
        echo "quorum-branch: $slug's worktree has uncommitted changes; commit or discard them first:" >&2
        git -C "$path" status --short >&2
        exit 3
      fi
      if [ -L "$MAIN/.tasks/$slug" ] && [ -d "$path/.tasks/$slug" ]; then
        rm "$MAIN/.tasks/$slug"
        mv "$path/.tasks/$slug" "$MAIN/.tasks/$slug"
      fi
      rm -rf "$path/.tasks"
      git worktree remove "$path"
    fi
    "$HERE/quorum-state" --task "$slug" clear worktree
    echo "removed $path (the branch stays)" ;;

  merged)
    "$HERE/quorum-active-task" --list | while IFS="$(printf '\t')" read -r slug _ path; do
      [ -n "$path" ] && [ -d "$path" ] || continue
      if is_merged "$slug"; then printf '%s\t%s\n' "$slug" "$path"; fi
    done
    exit 0 ;;

  is-merged)
    slug=${2:-}; [ -n "$slug" ] || die "is-merged needs a slug"
    is_merged "$slug" ;;

  range)
    base=$("$HERE/quorum-state" get base_sha)
    [ -n "$base" ] || die "base_sha isn't set (run /quorum:build first)"
    if last=$("$HERE/quorum-state" last round_shas 2>/dev/null); then
      printf '%s..HEAD\n' "$last"
    else
      printf '%s..HEAD\n' "$base"
    fi ;;

  record)
    "$HERE/quorum-state" push round_shas "$(git rev-parse HEAD)"
    git rev-parse HEAD ;;

  *) die "usage: quorum-branch default | start SLUG [--fix] [--worktree] | remove SLUG | merged | is-merged SLUG | range | record" ;;
esac
