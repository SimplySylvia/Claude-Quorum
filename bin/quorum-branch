#!/usr/bin/env bash
# Git helpers for Quorum tasks.
#
#   quorum-branch default                 print the default branch (origin/HEAD, else main, else master)
#   quorum-branch start SLUG [--fix]      switch to feat/SLUG (fix/SLUG with --fix), creating it from the default
#                                         branch; record base_sha in the task's state.md; print the branch
#   quorum-branch range                   the diff range to review now: base_sha..HEAD before any builder round,
#                                         then round_shas[-1]..HEAD (convergence Rule 2: new lines only)
#   quorum-branch record                  push HEAD onto round_shas (call just before each builder run)
#
# Refuses to switch branches with uncommitted changes. Bash 3.2 compatible.
set -euo pipefail

die() { echo "quorum-branch: $*" >&2; exit 1; }
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$("$HERE/quorum-active-task" --root)
cd "$ROOT"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo: $ROOT"

default_branch() {
  local ref
  if ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then printf '%s\n' "${ref#origin/}"; return; fi
  for b in main master; do
    if git show-ref --verify --quiet "refs/heads/$b"; then printf '%s\n' "$b"; return; fi
  done
  git branch --show-current
}

case "${1:-}" in
  default)
    default_branch ;;

  start)
    slug=${2:-}; [ -n "$slug" ] || die "start needs a slug"
    prefix=feat; [ "${3:-}" = "--fix" ] && prefix=fix
    [ -f ".tasks/$slug/state.md" ] || die "no state file for task $slug (run /quorum:spec-and-eval first)"
    cur=$(git branch --show-current)
    case "$cur" in
      "feat/$slug"|"fix/$slug") branch=$cur ;;
      *)
        if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
          die "uncommitted changes on $cur; commit or stash them before starting $prefix/$slug"
        fi
        branch="$prefix/$slug"
        if git show-ref --verify --quiet "refs/heads/$branch"; then
          git switch -q "$branch"
        else
          git switch -q -c "$branch" "$(default_branch)"
        fi ;;
    esac
    base=$("$HERE/quorum-state" --task "$slug" get base_sha)
    if [ -z "$base" ]; then
      def=$(default_branch)
      if [ "$branch" = "$def" ]; then die "refusing to work on the default branch $def"; fi
      base=$(git merge-base HEAD "$def" 2>/dev/null || git rev-parse HEAD)
      "$HERE/quorum-state" --task "$slug" set base_sha "$base"
    fi
    printf '%s\n' "$branch" ;;

  range)
    base=$("$HERE/quorum-state" get base_sha)
    [ -n "$base" ] || die "base_sha isn't set (run /quorum:build first)"
    if last=$("$HERE/quorum-state" last round_shas 2>/dev/null); then
      printf '%s..HEAD\n' "$last"
    else
      printf '%s..HEAD\n' "$base"
    fi ;;

  record)
    "$HERE/quorum-state" push round_shas "$(git rev-parse HEAD)"
    git rev-parse HEAD ;;

  *) die "usage: quorum-branch default | start SLUG [--fix] | range | record" ;;
esac
