#!/usr/bin/env bash
# Find and summarize Claude Code session logs, for /quorum:retro: what a session spent its tool calls on, without
# its content.
#
#   quorum-session path [SESSION_ID]       the session's log: the one with that id in any project, else this
#                                          project's newest. Exit 1 if there's none
#   quorum-session list [--since YYYY-MM-DD]
#                                          this project's sessions, newest first: ID<TAB>DATE<TAB>LINES
#   quorum-session summary [SESSION_ID | FILE]
#                                          what the session did, one line each, tab-separated:
#     tools<TAB>NAME<TAB>CALLS             calls per tool, most first
#     agents<TAB>TYPE<TAB>CALLS            subagents started, by type
#     failed<TAB>NAME<TAB>CALLS            calls per tool that returned an error
#     error<TAB>NAME<TAB>TEXT              the first line of each distinct error (80 characters, at most 20)
#     blocked<TAB>HOOK<TAB>CALLS           calls a hook blocked, by the hook's message prefix
#     reread<TAB>PATH<TAB>READS            files read 3 or more times
#     hunt<TAB>LONGEST<TAB>RUNS            the longest run of Read, Grep, and Glob calls with no edit between them,
#                                          and how many runs reached 8
#
# Logs live in ${CLAUDE_CONFIG_DIR:-~/.claude}/projects/<the project's path, with every character but letters and
# digits as ->/<session id>.jsonl. The summary reads tool names, file paths, and error first lines only: never the
# prompts, replies, or file contents. Bash 3.2 compatible.
set -euo pipefail

die() { echo "quorum-session: $*" >&2; exit 2; }
HERE=$(cd "$(dirname "$0")" && pwd)
command -v jq >/dev/null 2>&1 || die "needs jq"
PROJECTS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
project=${CLAUDE_PROJECT_DIR:-$("$HERE/quorum-active-task" --code 2>/dev/null || pwd)}
DIR="$PROJECTS/$(printf '%s' "$project" | sed 's/[^A-Za-z0-9]/-/g')"
valid_id() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]*$'; }

find_log() { # [ID]
  local f
  if [ -n "${1:-}" ]; then
    valid_id "$1" || die "invalid session id: $1"
    [ -f "$DIR/$1.jsonl" ] && { printf '%s\n' "$DIR/$1.jsonl"; return 0; }
    for f in "$PROJECTS"/*/"$1".jsonl; do [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }; done
    return 1
  fi
  # shellcheck disable=SC2012  # session logs are named <uuid>.jsonl, so ls is safe
  f=$(ls -t "$DIR"/*.jsonl 2>/dev/null | head -n 1) || true
  [ -n "$f" ] || return 1
  printf '%s\n' "$f"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  path)
    find_log "${1:-}" || { echo "quorum-session: no session log${1:+ for $1}" >&2; exit 1; } ;;

  list)
    since=""
    if [ "${1:-}" = --since ]; then
      since=${2:-}; printf '%s' "$since" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || die "--since needs YYYY-MM-DD"
    fi
    # shellcheck disable=SC2045  # session logs are named <uuid>.jsonl, so ls is safe
    for f in $(ls -t "$DIR"/*.jsonl 2>/dev/null); do
      d=$(date -r "$f" +%Y-%m-%d 2>/dev/null || stat -c %y "$f" | cut -c1-10)
      [ -z "$since" ] || [ ! "$d" \< "$since" ] || continue
      printf '%s\t%s\t%s\n' "$(basename "$f" .jsonl)" "$d" "$(wc -l < "$f" | tr -d ' ')"
    done ;;

  summary)
    arg=${1:-}
    if [ -n "$arg" ] && [ -f "$arg" ]; then log=$arg
    else log=$(find_log "$arg") || { echo "quorum-session: no session log${arg:+ for $arg}" >&2; exit 1; }
    fi
    # One record per tool call, in order: NAME<TAB>AGENT_TYPE<TAB>PATH<TAB>ERROR(0/1)<TAB>ERROR_FIRST_LINE
    calls=$(jq -r '
      def text: if type == "string" then . elif type == "array" then (map(.text? // "") | join("\n")) else "" end;
      if .type == "assistant" then
        (.message.content[]? | select(.type == "tool_use")
          | ["U", .id, .name, (.input.subagent_type // ""), (.input.file_path // .input.notebook_path // "")])
      elif .type == "user" then
        (.message.content[]? | select(.type == "tool_result")
          | ["R", .tool_use_id, (if .is_error then "1" else "0" end),
             ((.content | text | split("\n") | map(select(test("\\S")))
               | if (.[0] // "" | test("^Exit code [0-9]+$")) and length > 1 then .[0] + ": " + .[1] else .[0] // "" end)
              | .[0:80])])
      else empty end
      | map(tostring | gsub("\t"; " ")) | join("\t")' "$log" 2>/dev/null \
      | awk -F '\t' '
          $1 == "U" { n++; id[n] = $2; name[n] = $3; agent[n] = $4; path[n] = $5; at[$2] = n }
          $1 == "R" && ($2 in at) { k = at[$2]; err[k] = $3; msg[k] = $4 }
          END { for (i = 1; i <= n; i++) printf "%s\t%s\t%s\t%s\t%s\n", name[i], agent[i], path[i], err[i] + 0, msg[i] }')
    [ -n "$calls" ] || exit 0
    printf '%s\n' "$calls" | awk -F '\t' '
      { tools[$1]++
        if ($1 == "Agent" || $1 == "Task") agents[$2 == "" ? "general-purpose" : $2]++
        if ($4 == 1) {
          failed[$1]++
          if ($5 ~ /BLOCKED BY/) { h = $5; sub(/:.*/, "", h); blocked[h]++ }
          else if ($5 != "" && !(($1 SUBSEP $5) in seen) && nerr < 20) { seen[$1, $5] = 1; errs[++nerr] = $1 "\t" $5 }
        }
        if ($1 == "Read" && $3 != "") reads[$3]++
        if ($1 == "Read" || $1 == "Grep" || $1 == "Glob") { run++; if (run > longest) longest = run }
        else if ($1 == "Edit" || $1 == "Write" || $1 == "NotebookEdit") { if (run >= 8) runs++; run = 0 }
      }
      END {
        if (run >= 8) runs++
        for (t in tools) printf "tools\t%s\t%d\n", t, tools[t] | "sort -t \"\t\" -k3,3nr"
        close("sort -t \"\t\" -k3,3nr")
        for (a in agents) printf "agents\t%s\t%d\n", a, agents[a]
        for (t in failed) printf "failed\t%s\t%d\n", t, failed[t]
        for (i = 1; i <= nerr; i++) printf "error\t%s\n", errs[i]
        for (h in blocked) printf "blocked\t%s\t%d\n", h, blocked[h]
        for (p in reads) if (reads[p] >= 3) printf "reread\t%s\t%d\n", p, reads[p]
        printf "hunt\t%d\t%d\n", longest, runs
      }' ;;

  *) die "usage: quorum-session path [ID] | list [--since YYYY-MM-DD] | summary [ID | FILE]" ;;
esac
