#!/usr/bin/env bash
# Read and update the YAML frontmatter of .tasks/<slug>/state.md.
#
#   quorum-state [--task SLUG] path                  print the state file path
#   quorum-state --task SLUG init RISK [STATUS]      create state.md (STATUS defaults to BUILDING)
#   quorum-state [--task SLUG] get KEY               scalar value (empty for null), or list items one per line
#   quorum-state [--task SLUG] set KEY VALUE         set a scalar (validated: status, risk, counters, pr, models)
#   quorum-state [--task SLUG] incr KEY              add 1 to a counter and print the new value
#   quorum-state [--task SLUG] push KEY VALUE        append to a list (round_shas, pending_findings)
#   quorum-state [--task SLUG] last KEY              last list item (exit 1 if the list is empty)
#   quorum-state [--task SLUG] clear KEY             empty a list, or set a scalar to null
#   quorum-state [--task SLUG] log < TEXT            append TEXT (stdin) to the body, the human-readable round log
#
# Setting status READY or AWAITING-HUMAN needs a proof: .tasks/<slug>/proof-final.md from the prover, run at the
# current HEAD, with no failed check ("Result: ALL PASS" or "<n> SKIPPED"). `pr` is the task's pull request URL.
# `reviewer_model` and `helper_model` are the models chosen for the task's agents (skills/pipeline-laws/models.md):
# `inherit` or a value the Agent tool's `model` parameter accepts.
# A standalone review (/quorum:review) keeps its state in .tasks/review-<id>/ with `kind: review`, the `range` it
# reviewed, and status REVIEWING, FIXING (its builder is fixing the kept findings), or REVIEWED. No `kind` is a task.
#
# Without --task, the slug comes from quorum-active-task. The frontmatter is rewritten in canonical key order;
# the body after the closing --- is kept as is. Values may not contain tabs or newlines. Bash 3.2 compatible.
set -euo pipefail

die() { echo "quorum-state: $*" >&2; exit 1; }

HERE=$(cd "$(dirname "$0")" && pwd)
# Through quorum-git, so a sandbox that hides the real git behind Apple's launcher doesn't break this script.
git() { "$HERE/quorum-git" "$@"; }
ORDER="slug kind range risk status round base_sha round_shas stop_blocks signoff plan_rounds plan_approved pending_findings blind_runs escalated_from reviewer_model helper_model pr"
LISTS=" round_shas pending_findings "
COUNTERS=" round stop_blocks plan_rounds blind_runs "
STATUSES=" DRAFT-AWAITING-VISUAL-SIGNOFF PLANNING BUILDING IN_REVIEW CONVERGED BLIND-TEST READY AWAITING-HUMAN HALTED ESCALATED REVIEWING FIXING REVIEWED "
RISKS=" LOW MEDIUM HIGH "

is_in() { case "$2" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
known_key() { is_in "$1" " $ORDER "; }

task=""
if [ "${1:-}" = "--task" ]; then
  task=${2:-}; [ -n "$task" ] || die "--task needs a slug"; shift 2
fi
cmd=${1:-}; [ -n "$cmd" ] || die "missing command (path, init, get, set, incr, push, last, clear, log)"; shift

ROOT=$("$HERE/quorum-active-task" --root)
if [ -z "$task" ]; then
  task=$("$HERE/quorum-active-task") || exit 1
fi
printf '%s' "$task" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' || die "invalid slug: $task"
FILE="$ROOT/.tasks/$task/state.md"

# ---------------------------------------------------------------- parse / render
# Records, one per line, tab-separated:  S key value | B key (list start) | L key item
parse() {
  awk '
    function unq(v,   out, i, c) {
      if (substr(v, 1, 1) == "\"") {
        out = ""
        for (i = 2; i <= length(v); i++) {
          c = substr(v, i, 1)
          if (c == "\\") { i++; out = out substr(v, i, 1); continue }
          if (c == "\"") break
          out = out c
        }
        return out
      }
      sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v)
      return v
    }
    NR == 1 { if ($0 == "---") { fm = 1; next } else exit }
    fm && $0 == "---" { exit }
    fm {
      if ($0 ~ /^[ \t]*(#.*)?$/) next
      if ($0 ~ /^[ \t]+- /) { item = $0; sub(/^[ \t]+- /, "", item); print "L\t" cur "\t" unq(item); next }
      if (match($0, /^[A-Za-z_][A-Za-z0-9_]*:/)) {
        key = substr($0, 1, RLENGTH - 1); val = substr($0, RLENGTH + 1); sub(/^[ \t]+/, "", val); cur = key
        if (val == "" || val ~ /^#/) { print "B\t" key; next }
        if (substr(val, 1, 1) == "[") {
          print "B\t" key
          sub(/^\[/, "", val); sub(/\][ \t]*(#.*)?$/, "", val)
          n = split(val, parts, ",")
          for (i = 1; i <= n; i++) { p = parts[i]; sub(/^[ \t]+/, "", p); sub(/[ \t]+$/, "", p); if (p != "") print "L\t" key "\t" unq(p) }
          next
        }
        print "S\t" key "\t" unq(val)
      }
    }
  ' "$1"
}

body() { awk 'NR == 1 && $0 == "---" { fm = 1; next } fm == 1 && $0 == "---" { fm = 2; next } fm == 2 { print }' "$1"; }

render() { # $1 = records file; writes frontmatter to stdout
  awk -F '\t' -v order="$ORDER" -v lists="$LISTS" '
    function q(v) { if (v ~ /^[A-Za-z0-9._:\/@+-]*$/ && v != "") return v; gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v); return "\"" v "\"" }
    function qi(v) { gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v); return "\"" v "\"" }
    {
      if (!($2 in seen)) { seen[$2] = 1; keys[++nk] = $2 }
      if ($1 == "S") { sval[$2] = $3; kind[$2] = "S" }
      else if ($1 == "B") { kind[$2] = "L"; if (!($2 in cnt)) cnt[$2] = 0 }
      else if ($1 == "L") { kind[$2] = "L"; items[$2, ++cnt[$2]] = $3 }
    }
    function emit(k,   i) {
      if (done[k]) return; done[k] = 1
      if (kind[k] == "L" || index(lists, " " k " ")) {
        if (cnt[k] + 0 == 0) { print k ": []"; return }
        print k ":"; for (i = 1; i <= cnt[k]; i++) print "  - " qi(items[k, i])
      } else if (k in sval) print k ": " (sval[k] == "" ? "null" : q(sval[k]))
    }
    END {
      print "---"
      n = split(order, ord, " ")
      for (i = 1; i <= n; i++) if (ord[i] in seen) emit(ord[i])
      for (i = 1; i <= nk; i++) emit(keys[i])
      print "---"
    }
  ' "$1"
}

write_state() { # $1 = records file
  local tmp; tmp=$(mktemp "${FILE}.XXXXXX")
  { render "$1"; body "$FILE"; } > "$tmp"
  mv "$tmp" "$FILE"
}

need_file() { [ -f "$FILE" ] || die "no state file: .tasks/$task/state.md"; }
check_value() { case "$1" in *$'\t'*|*$'\n'*) die "values may not contain tabs or newlines" ;; esac; }

# A task is finished only with a proof (Law 1): the prover's proof-final.md, for the commit at HEAD, with no FAIL.
require_proof() { # status
  local proof="$ROOT/.tasks/$task/proof-final.md" result rev head
  [ -f "$proof" ] || die "can't set $1 without .tasks/$task/proof-final.md: run quorum:prover on every eval.md row and save its reply there"
  result=$(sed -n 's/^Result:[[:space:]]*//p' "$proof" | head -n 1)
  [ -n "$result" ] || die "proof-final.md has no \"Result:\" line; save the prover's reply verbatim"
  case "$result" in *FAIL*) die "proof-final.md says \"Result: $result\"; fix the failures and run the prover again before $1" ;; esac
  rev=$(sed -n 's/^Proof:.* at \([0-9a-fA-F]\{7,40\}\).*/\1/p' "$proof" | head -n 1)
  [ -n "$rev" ] || die "proof-final.md doesn't name the commit it ran at (\"Proof: <slug> at <sha>\"); run the prover again"
  if head=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null); then
    case "$head" in "$rev"*) ;; *) die "proof-final.md is for $rev, but HEAD is $(printf '%s' "$head" | cut -c1-12); run the prover again before $1" ;; esac
  fi
}

validate_scalar() { # key value
  if is_in "$1" "$LISTS"; then die "$1 is a list; use push, last, or clear"; fi
  case "$1" in
    status)
      is_in "$2" "$STATUSES" || die "unknown status: $2"
      case "$2" in READY|AWAITING-HUMAN) require_proof "$2" ;; esac ;;
    risk) is_in "$2" "$RISKS" || die "unknown risk tier: $2 (LOW, MEDIUM, HIGH)" ;;
    kind) case "$2" in task|review) ;; *) die "kind must be task or review" ;; esac ;;
    range) printf '%s' "$2" | grep -Eq '^[^[:space:]]+$' || die "range must be one git range, with no spaces" ;;
    pr) printf '%s' "$2" | grep -Eq '^https?://[^[:space:]]+/pull/[0-9]+$' || die "pr must be a pull request URL (https://github.com/<owner>/<repo>/pull/<n>)" ;;
    reviewer_model|helper_model)
      printf '%s' "$2" | grep -Eq '^[A-Za-z0-9][]A-Za-z0-9._:@/[-]*$' || die "$1 must be inherit or a model name or ID, with no spaces" ;;
  esac
  if is_in "$1" "$COUNTERS"; then printf '%s' "$2" | grep -Eq '^[0-9]+$' || die "$1 must be a non-negative integer"; fi
  check_value "$2"
}

# ---------------------------------------------------------------- commands
# Scratch files live in .tasks/, which is always writable (Claude Code's Bash sandbox can block the system temp dir).
mkdir -p "$ROOT/.tasks"
recs=$(mktemp "$ROOT/.tasks/.quorum-state.XXXXXX"); trap 'rm -f "$recs" "$recs.new"' EXIT

case "$cmd" in
  path)
    printf '%s\n' "$FILE" ;;

  init)
    risk=${1:-}; status=${2:-BUILDING}
    [ -n "$risk" ] || die "init needs a risk tier"
    [ -e "$FILE" ] && die "state file already exists: .tasks/$task/state.md"
    is_in "$risk" "$RISKS" || die "unknown risk tier: $risk (LOW, MEDIUM, HIGH)"
    is_in "$status" "$STATUSES" || die "unknown status: $status"
    case "$status" in READY|AWAITING-HUMAN) require_proof "$status" ;; esac
    mkdir -p "$(dirname "$FILE")"
    {
      printf -- '---\nslug: %s\nrisk: %s\nstatus: %s\nround: 0\nbase_sha: null\nround_shas: []\nstop_blocks: 0\n' "$task" "$risk" "$status"
      printf -- 'signoff: null\nplan_rounds: 0\nplan_approved: null\npending_findings: []\nblind_runs: 0\n'
      printf -- 'escalated_from: null\nreviewer_model: null\nhelper_model: null\npr: null\n---\n# %s\n' "$task"
    } > "$FILE" ;;

  get)
    key=${1:-}; [ -n "$key" ] || die "get needs a key"; need_file
    parse "$FILE" > "$recs"
    if is_in "$key" "$LISTS"; then
      awk -F '\t' -v k="$key" '$1 == "L" && $2 == k { print $3 }' "$recs"
    else
      awk -F '\t' -v k="$key" '$1 == "S" && $2 == k { v = $3; found = 1 } END { if (found && v != "null") print v }' "$recs"
    fi ;;

  set)
    key=${1:-}; [ $# -ge 2 ] || die "set needs a key and a value"; val=$2; need_file
    known_key "$key" || die "unknown key: $key"
    validate_scalar "$key" "$val"
    parse "$FILE" > "$recs"
    awk -F '\t' -v k="$key" '!($1 == "S" && $2 == k)' "$recs" > "$recs.new"
    printf 'S\t%s\t%s\n' "$key" "$val" >> "$recs.new"
    write_state "$recs.new" ;;

  incr)
    key=${1:-}; [ -n "$key" ] || die "incr needs a key"; need_file
    is_in "$key" "$COUNTERS" || die "$key is not a counter (round, stop_blocks, plan_rounds, blind_runs)"
    cur=$("$0" --task "$task" get "$key"); cur=${cur:-0}
    printf '%s' "$cur" | grep -Eq '^[0-9]+$' || die "$key is not an integer: $cur"
    new=$((cur + 1))
    "$0" --task "$task" set "$key" "$new"
    printf '%s\n' "$new" ;;

  push)
    key=${1:-}; [ $# -ge 2 ] || die "push needs a key and a value"; val=$2; need_file
    is_in "$key" "$LISTS" || die "$key is not a list (round_shas, pending_findings)"
    check_value "$val"; [ -n "$val" ] || die "push needs a non-empty value"
    parse "$FILE" > "$recs"
    awk -F '\t' -v k="$key" '$1 == "B" && $2 == k { f = 1 } END { exit !f }' "$recs" || printf 'B\t%s\n' "$key" >> "$recs"
    printf 'L\t%s\t%s\n' "$key" "$val" >> "$recs"
    write_state "$recs" ;;

  last)
    key=${1:-}; [ -n "$key" ] || die "last needs a key"; need_file
    is_in "$key" "$LISTS" || die "$key is not a list (round_shas, pending_findings)"
    parse "$FILE" > "$recs"
    out=$(awk -F '\t' -v k="$key" '$1 == "L" && $2 == k { v = $3; n++ } END { if (n) print v }' "$recs")
    [ -n "$out" ] || exit 1
    printf '%s\n' "$out" ;;

  clear)
    key=${1:-}; [ -n "$key" ] || die "clear needs a key"; need_file
    known_key "$key" || die "unknown key: $key"
    parse "$FILE" > "$recs"
    if is_in "$key" "$LISTS"; then
      awk -F '\t' -v k="$key" '!($1 == "L" && $2 == k)' "$recs" > "$recs.new"
    else
      is_in "$key" " slug risk " && die "$key can't be cleared"
      awk -F '\t' -v k="$key" '{ if ($1 == "S" && $2 == k) { print "S\t" k "\tnull"; f = 1 } else print } END { if (!f) print "S\t" k "\tnull" }' "$recs" > "$recs.new"
    fi
    write_state "$recs.new" ;;

  log)
    need_file
    text=$(cat)
    [ -n "$text" ] || die "log needs text on stdin"
    [ -z "$(tail -c 1 "$FILE")" ] || printf '\n' >> "$FILE"
    printf '\n%s\n' "$text" >> "$FILE" ;;

  *) die "unknown command: $cmd" ;;
esac
