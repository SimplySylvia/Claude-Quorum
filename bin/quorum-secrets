#!/usr/bin/env bash
# Find secrets before they're read or committed. Prints where and what kind, never the secret itself.
#
#   quorum-secrets path PATH        exit 0 if PATH names a credential file (.env, private keys, .npmrc, ...), else 1
#   quorum-secrets staged [--all]   scan the lines the next commit adds: the staged diff, or with --all (git commit -a)
#                                   every change to tracked files. Prints FILE:LINE: KIND per match; exit 1 if any
#   quorum-secrets text             scan stdin (a web search query, a URL): prints KIND per match; exit 1 if any
#
# Credential files: .env and .env.* (but not .env.example, .env.sample, .env.template, .env.dist, .env.defaults),
# *.pem, *.key, *.p12, *.pfx, SSH private keys (id_rsa, id_ed25519, id_ecdsa, id_dsa, not .pub), .npmrc, .pypirc,
# .netrc, .git-credentials, an AWS `credentials` file, and *credentials*.json or service-account*.json.
#
# Secrets in a line: AWS access key IDs, private key blocks, GitHub, Slack, Stripe live, Google, Anthropic, and
# OpenAI keys, and a quoted value of 12 or more characters assigned to a name like password, secret, api_key, or
# token. A line with `quorum: allow-secret` in it is skipped (a test fixture's fake key, say). Bash 3.2 compatible.
set -uo pipefail

die() { echo "quorum-secrets: $*" >&2; exit 2; }
HERE=$(cd "$(dirname "$0")" && pwd)
git() { "$HERE/quorum-git" "$@"; }

is_secret_path() {
  local name=${1##*/}
  case "$name" in
    .env.example|.env.sample|.env.template|.env.dist|.env.defaults|*.pub) return 1 ;;
    .env|.env.*|*.pem|*.key|*.p12|*.pfx|id_rsa|id_rsa.*|id_ed25519|id_ed25519.*|id_ecdsa|id_ecdsa.*|id_dsa) return 0 ;;
    .npmrc|.pypirc|.netrc|.git-credentials|*credentials*.json|service-account*.json) return 0 ;;
    credentials) case "$1" in *.aws/credentials|credentials) return 0 ;; esac ;;
  esac
  return 1
}

# Reads `git diff -U0` on stdin and prints FILE:LINE: KIND for each added line holding a secret.
scan_diff() {
  awk '
    BEGIN {
      n = 0
      kind[++n] = "AWS access key ID";   re[n] = "(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}"
      kind[++n] = "private key";         re[n] = "-----BEGIN ([A-Z]+ )*PRIVATE KEY( BLOCK)?-----"
      kind[++n] = "GitHub token";        re[n] = "(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})"
      kind[++n] = "Slack token";         re[n] = "xox[abposr]-[A-Za-z0-9-]{10,}"
      kind[++n] = "Stripe live key";     re[n] = "(sk|rk)_live_[A-Za-z0-9]{20,}"
      kind[++n] = "Google API key";      re[n] = "AIza[0-9A-Za-z_-]{35}"
      kind[++n] = "Anthropic API key";   re[n] = "sk-ant-[A-Za-z0-9_-]{20,}"
      kind[++n] = "OpenAI API key";      re[n] = "sk-(proj-)?[A-Za-z0-9]{32,}"
      generic = "(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)[\"'\'']?[ \t]*[:=][ \t]*[\"'\''][^\"'\'' \t]{12,}[\"'\'']"
    }
    /^\+\+\+ / { file = substr($0, 5); sub(/^b\//, "", file); next }
    /^@@ / { split($0, a, " "); split(substr(a[3], 2), b, ","); line = b[1] + 0; next }
    /^\+/ {
      text = substr($0, 2)
      if (text !~ /quorum: allow-secret/) {
        found = ""
        for (i = 1; i <= n; i++) if (text ~ re[i]) { found = kind[i]; break }
        if (found == "" && tolower(text) ~ generic) found = "possible secret (a password, key, or token in a quoted value)"
        if (found != "") print file ":" line ": " found
      }
      line++
    }
  '
}

case "${1:-}" in
  path)
    [ -n "${2:-}" ] || die "usage: quorum-secrets path PATH"
    is_secret_path "$2" ;;
  staged)
    if [ "${2:-}" = --all ]; then diff=$(git diff HEAD -U0 --no-color --no-ext-diff 2>/dev/null) || diff=$(git diff -U0 --no-color --no-ext-diff)
    else diff=$(git diff --cached -U0 --no-color --no-ext-diff) || die "not a git repository"
    fi
    found=$(printf '%s\n' "$diff" | scan_diff)
    [ -z "$found" ] && exit 0
    printf '%s\n' "$found"
    exit 1 ;;
  text)
    found=$({ printf '+++ b/text\n@@ -0,0 +1 @@\n'; sed 's/^/+/'; } | scan_diff | sed 's/^[^ ]* //' | sort -u)
    [ -z "$found" ] && exit 0
    printf '%s\n' "$found"
    exit 1 ;;
  *) die "usage: quorum-secrets path PATH | staged [--all] | text" ;;
esac
